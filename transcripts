)
video_file = downloads_path / video_filename

# Output file path
output_txt = downloads_path / "Meeting_Transcript.txt"

print(f"Loading file: {video_file}")

if not video_file.exists():
    print(f"Error: Could not find file at {video_file}")
    exit(1)

# 2. Load the Whisper model locally
# Options: 'tiny', 'base', 'small', 'medium'
# 'base' or 'small' are recommended for standard office laptops (good accuracy + fast on CPU)
print("Loading local Whisper model (running offline on your PC)...")
model = whisper.load_model("base")

# 3. Transcribe directly from the MP4 file
print("Transcribing... This may take a few minutes depending on meeting length.")
result = model.transcribe(str(video_file), fp16=False)

# 4. Save the full transcript and timestamped version
