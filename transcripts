    f.write("=== FULL TRANSCRIPT ===\n\n")
    f.write(result["text"])
    f.write("\n\n=== TIMESTAMPS ===\n\n")
    for segment in result["segments"]:
        start = int(segment["start"])
        end = int(segment["end"])
        f.write(
            f"[{start//60:02d}:{start%60:02d} -> {end//60:02d}:{end%60:02d}] {segment['text'].strip()}\n"
        )

print(f"\n Transcription complete! Saved to:\n{output_txt}")


